    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "desc": {
      "type": "string"
    },
    "descData": {
      "type": "object",
      "properties": {
        "emoji": {
          "type": "object"
        }
      },
      "required": [
