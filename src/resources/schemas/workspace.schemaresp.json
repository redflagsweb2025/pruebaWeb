    "url": {
      "type": "string"
    },
    "website": {
      "type": "null"
    },
    "teamType": {
      "type": "null"
    },
    "logoHash": {
      "type": "null"
    },
    "logoUrl": {
      "type": "null"
    },
    "offering": {
      "type": "string"
    },
    "products": {
      "type": "array",
      "items": {}
    },
    "powerUps": {
      "type": "array",
      "items": {}
    },
