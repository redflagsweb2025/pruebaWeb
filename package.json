{
  "name": "pruebaweb",
  "version": "1.0.0",
  "description": "pruebaWebSelenium",
  "main": "playwright.config.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "postinstall": "playwright install",
    "test:smoke": "RUN_TAGS=@smoke playwright test",
    "test:integration": "RUN_TAGS=@integration playwright test",
    "allure:gen": "allure generate ./allure-results -o ./allure-report --clean",
    "allure:open": "allure open \"./allure-report\""
  },
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^6.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.1",
    "dotenv": "^17.2.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
